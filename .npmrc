# eslint-plugin-jsx-a11y@6.10.2 (latest) still declares a peer range capped at
# eslint ^9, while eslint-plugin-astro@3.1 requires eslint >=10. The two cannot
# be satisfied together, so strict peer resolution fails `npm ci` — including on
# Vercel, before the build ever starts. The plugin works fine on eslint 10; this
# lets installs resolve until upstream widens the range.
legacy-peer-deps=true
