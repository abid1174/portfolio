---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/astro/Footer.astro';
import Header from '../components/astro/Header.astro';
import Sidebar from '../components/astro/Sidebar.astro';
import type { MetaInput } from '../lib/metadata';

type Props = Omit<MetaInput, 'pathname'> & {
  jsonLd?: unknown[];
  pillarClass?: string;
  /** `wide` removes the max-width cap for full-bleed listings. */
  width?: 'default' | 'wide';
};

const { width = 'default', ...rest } = Astro.props;
---

<BaseLayout {...rest}>
  <div class="shell">
    <Sidebar />
    <div class="scrim" data-drawer-scrim aria-hidden="true"></div>

    <div class="column">
      <Header />
      <main id="main" class:list={['main', `is-${width}`]} tabindex="-1">
        <slot />
      </main>
      <div class="footer-wrap">
        <Footer />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .shell {
    display: flex;
    min-height: 100dvh;
  }

  .column {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .main {
    flex: 1;
    width: 100%;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: clamp(1.25rem, 3vw, 2.25rem) clamp(1rem, 3vw, 2rem) 0;
  }

  .main:focus {
    outline: none;
  }

  .footer-wrap {
    width: 100%;
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: clamp(1rem, 3vw, 2rem);
  }

  .scrim {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--bg-primary) 70%, transparent);
    backdrop-filter: blur(2px);
  }

  @media (max-width: 64rem) {
    :global(body[data-drawer='open']) .scrim {
      display: block;
    }
    /* Locking the page behind the drawer prevents scroll bleed. */
    :global(body[data-drawer='open']) {
      overflow: hidden;
    }
  }
</style>
