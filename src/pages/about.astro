---
import PageLayout from '../layouts/PageLayout.astro';
import SectionHeader from '../components/astro/SectionHeader.astro';
import ExperienceTimeline from '../components/astro/ExperienceTimeline.astro';
import InteractiveDiagram from '../components/react/InteractiveDiagram';
import BrandIcon from '../components/astro/BrandIcon.astro';
import { GraduationCap, Mail } from 'lucide-react';
import { breadcrumbJsonLd } from '../lib/metadata';
import { ContentRepository } from '../lib/content';
import { yearsOfExperience } from '../lib/career';
import { site } from '../data/site';
import {
  certifications,
  education,
  focusAreas,
  location,
  roles,
  toolkit,
} from '../data/resume';

const stats = await ContentRepository.stats();
const years = yearsOfExperience(roles);
const companies = new Set(roles.map((role) => role.company)).size;
const current = roles.find((role) => !role.end);

const layers = [
  {
    id: 'concepts',
    label: 'Concepts',
    summary: 'The vocabulary everything else is written in.',
    detail:
      'Single ideas, explained once and properly. A concept page exists because I had to look the idea up more than twice, or because the explanations I found skipped the part that actually mattered.',
    items: [
      'Authentication and tokens',
      'Networking and protocols',
      'Databases, indexes, caching',
      'Distributed systems primitives',
    ],
    accent: 'var(--accent-ochre)',
  },
  {
    id: 'system-design',
    label: 'System Design',
    summary: 'Concepts assembled into something that has to survive production.',
    detail:
      'Each walkthrough follows the same twelve sections so designs can be compared rather than admired. The interesting part is never the boxes — it is the capacity numbers and the failure handling that force the boxes to be what they are.',
    items: [
      'Requirements before architecture',
      'Capacity estimation with real arithmetic',
      'Explicit trade-offs and decisions',
      'What breaks, and what happens then',
    ],
    accent: 'var(--accent-blue)',
  },
  {
    id: 'ai',
    label: 'AI Learning',
    summary: 'The newest layer, and the one changing fastest.',
    detail:
      'Notes on how retrieval, embeddings, agents and evaluation actually behave when wired into a backend. Written from the same angle as the rest of the site: mechanisms and costs, not capabilities and hype.',
    items: [
      'Retrieval and embeddings',
      'Agents and tool calling',
      'Evaluation that means something',
      'Serving and infrastructure',
    ],
    accent: 'var(--accent-green)',
  },
];

const principles = [
  {
    title: 'Explain the mechanism',
    body: 'If a page cannot say what actually happens on the wire, in memory, or on disk, it is not finished.',
  },
  {
    title: 'Show the numbers',
    body: 'Capacity, latency budgets and failure rates decide architecture. Designs without arithmetic are opinions.',
  },
  {
    title: 'Name the trade-off',
    body: 'Every choice costs something. The page should say what, not just recommend the winner.',
  },
  {
    title: 'Revise in public',
    body: 'Pages get corrected as I learn more. The updated date is meaningful, not decorative.',
  },
];
---

<PageLayout
  title="About"
  description={`${site.name} — ${site.role}. ${site.bio}`}
  jsonLd={[breadcrumbJsonLd([{ label: 'Home', href: '/' }, { label: 'About' }])]}
>
  <div class="page">
    <SectionHeader level="page" title={site.name} description={site.bio} />

    <div class="intro">
      <div class="intro-copy">
        <p class="lede">
          I am a {site.role.toLowerCase()} with {years}+ years of building backend and frontend
          systems{current && <>, currently at {current.company}</>}. Most of my work sits where
          architecture meets operations: designing the service, then making it deploy, scale and
          stay observable once real traffic arrives.
        </p>
        <p>
          Along the way I have led frontend and backend teams, moved slow work onto event-driven
          pipelines, and built the delivery platforms other engineers ship on. These days I am
          also working out where AI fits into that picture.
        </p>
        <p>
          This site is the notebook I keep alongside that work: {stats.total} entries covering the
          concepts I rely on, the system designs I have worked through, and what I am learning about
          AI. Pages appear when I understand something well enough to explain it, and get revised
          when I realise I did not.
        </p>

        <ul class="contact">
          <li>
            <a href={site.social[0].href} target="_blank" rel="me noopener noreferrer">
              <BrandIcon name="GitHub" />
              {site.social[0].handle}
            </a>
          </li>
          <li>
            <a href={site.social[1].href} target="_blank" rel="me noopener noreferrer">
              <BrandIcon name="LinkedIn" />
              {site.social[1].handle}
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email}`}>
              <Mail size={14} strokeWidth={2} aria-hidden="true" />
              {site.email}
            </a>
          </li>
        </ul>
      </div>

      <dl class="figures">
        <div><dt>Experience</dt><dd>{years}+ yrs</dd></div>
        <div><dt>Companies</dt><dd>{companies}</dd></div>
        <div><dt>Based in</dt><dd class="text">{location}</dd></div>
        <div><dt>Notes written</dt><dd>{stats.total}</dd></div>
      </dl>
    </div>

    <section class="block">
      <SectionHeader
        title="What I work on"
        description="The threads that keep showing up, whichever company or stack I am in."
      />
      <ul class="focus">
        {
          focusAreas.map((area) => (
            <li>
              <h3>{area.title}</h3>
              <p>{area.body}</p>
              <p class="proof">{area.proof}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block">
      <SectionHeader
        title="Experience"
        description="From first APIs to leading teams — most recent first."
      />
      <ExperienceTimeline roles={roles} />
    </section>

    <section class="block">
      <SectionHeader
        title="Toolkit"
        description="What I reach for, grouped by where it lives."
      />
      <dl class="toolkit">
        {
          toolkit.map((group) => (
            <div>
              <dt>{group.label}</dt>
              <dd>
                <ul>
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="block">
      <SectionHeader title="Education" />
      <div class="education">
        <GraduationCap size={20} strokeWidth={1.75} aria-hidden="true" />
        <div>
          <h3>{education.degree}</h3>
          <p>
            {education.school} · {education.start} — {education.end}
          </p>
          {
            certifications.length > 0 && (
              <p class="cert">Certified: {certifications.join(', ')}</p>
            )
          }
        </div>
      </div>
    </section>

    <p class="part">About this site</p>

    <section class="block">
      <SectionHeader
        title="Three layers, one model"
        description="Each layer depends on the one above it. Select a layer to see what belongs there."
      />
      <InteractiveDiagram client:visible layers={layers} />
    </section>

    <section class="block">
      <SectionHeader title="How pages get written" />
      <ul class="principles">
        {
          principles.map((principle, i) => (
            <li>
              <span class="principle-no" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>{principle.title}</h3>
              <p>{principle.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block">
      <SectionHeader title="How it is built" />
      <p class="colophon">
        Astro with React islands, MDX content in Git, Zod-validated frontmatter, Tailwind on top
        of CSS custom properties, and a client-side search index built at compile time. No
        database, no CMS, no analytics. Bookmarks live in your browser and never leave it.
      </p>
    </section>
  </div>
</PageLayout>

<style>
  .page {
    display: grid;
    gap: clamp(2rem, 4vw, 2.75rem);
  }

  .block {
    display: grid;
    gap: 1.25rem;
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 16rem);
    gap: 2rem;
    align-items: start;
  }

  .intro-copy p {
    margin: 0 0 1rem;
    max-width: 62ch;
    font-size: var(--text-body);
    line-height: var(--leading-prose);
    color: var(--text-secondary);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .contact a:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
  }

  .figures {
    display: grid;
    gap: 0;
    margin: 0;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
  }

  .figures > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.9rem;
  }
  .figures > div + div {
    border-top: 1px solid var(--border-subtle);
  }

  .figures dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .figures dd {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .principles li {
    padding: 1rem 1.05rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .principle-no {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--accent-ochre);
  }

  .principles h3 {
    margin: 0.35rem 0 0.4rem;
    font-size: 1rem;
    color: var(--text-primary);
  }

  .principles p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .colophon {
    margin: 0;
    max-width: 62ch;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .intro-copy .lede {
    font-size: var(--text-lg);
    color: var(--text-primary);
  }

  .figures dd.text {
    font-size: var(--text-md);
    font-weight: 500;
  }

  .focus {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Three per row on a six-column grid, so an incomplete last row can stretch to fill the width
     instead of leaving an orphan card — whatever the number of focus areas. */
  .focus li {
    grid-column: span 2;
  }
  .focus li:nth-last-child(2):nth-child(3n + 1),
  .focus li:last-child:nth-child(3n + 2) {
    grid-column: span 3;
  }
  .focus li:last-child:nth-child(3n + 1) {
    grid-column: span 6;
  }

  .focus li {
    display: flex;
    flex-direction: column;
    padding: 1rem 1.05rem;
    border: 1px solid var(--border-subtle);
    border-top: 2px solid var(--pillar);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .focus h3 {
    margin: 0 0 0.4rem;
    font-size: 1rem;
    color: var(--text-primary);
  }

  .focus p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Pushed to the bottom so the evidence lines align across cards of different lengths. */
  .focus .proof {
    margin-top: auto;
    padding-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--pillar-dim);
  }

  .toolkit {
    display: grid;
    margin: 0;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .toolkit > div {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding: 0.7rem 1rem;
  }
  .toolkit > div + div {
    border-top: 1px solid var(--border-subtle);
  }

  .toolkit dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .toolkit dd {
    margin: 0;
  }

  .toolkit ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toolkit li {
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-inset);
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  .education {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--pillar);
  }

  .education h3 {
    margin: 0;
    font-size: 1rem;
    color: var(--text-primary);
  }

  .education p {
    margin: 0.2rem 0 0;
    font-size: var(--text-md);
    color: var(--text-secondary);
  }

  .education .cert {
    margin-top: 0.5rem;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  /* Divides the person from the publication: everything above is about me, below about the site. */
  .part {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1rem 0 -0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .part::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border-default);
  }

  @media (max-width: 60rem) {
    .intro {
      grid-template-columns: 1fr;
    }
    .principles {
      grid-template-columns: 1fr;
    }
    .focus {
      grid-template-columns: 1fr;
    }
    .focus li,
    .focus li:nth-last-child(2):nth-child(3n + 1),
    .focus li:last-child:nth-child(3n + 2),
    .focus li:last-child:nth-child(3n + 1) {
      grid-column: auto;
    }
  }

  @media (max-width: 36rem) {
    .toolkit > div {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }
  }
</style>
