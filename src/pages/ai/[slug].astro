---
import { render } from 'astro:content';
import AILearningLayout from '../../layouts/AILearningLayout.astro';
import { mdxComponents } from '../../components/mdx/components';
import { ContentRepository } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await ContentRepository.byPillar('ai');
  // Only the slug travels in props; the repository is cached, so
  // re-reading the entry below costs nothing.
  return entries.map((entry) => ({ params: { slug: entry.slug } }));
}

const { slug } = Astro.params;
const entry = await ContentRepository.bySlug('ai', slug!);

if (!entry) {
  return Astro.rewrite('/404');
}

const { Content, headings } = await render(entry.raw);
---

<AILearningLayout entry={entry} headings={headings}>
  <Content components={mdxComponents} />
</AILearningLayout>
