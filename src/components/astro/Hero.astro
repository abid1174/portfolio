---
import HeroVisual from './HeroVisual.astro';
import StatGrid from './StatGrid.astro';
import { ArrowRight } from 'lucide-react';
import type { ContentStats } from '../../lib/content';

interface Props {
  stats: ContentStats;
}

const { stats } = Astro.props;

// Every figure is derived from the content collections — adding an
// article updates the hero with no code change.
const figures = [
  { value: String(stats.concepts), label: 'Concepts', accent: 'var(--accent-ochre)' },
  {
    value: String(stats.systemDesigns),
    label: 'System Designs',
    accent: 'var(--accent-blue)',
  },
  {
    value: String(stats.practices),
    label: 'Engineering Practices',
    accent: 'var(--border-strong)',
  },
  { value: String(stats.ai), label: 'AI Notes', accent: 'var(--accent-green)' },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-inner">
    <div class="hero-copy">
      <h1 id="hero-title">
        <span class="line">Clear concepts.</span>
        <span class="line">Scalable systems.</span>
        <span class="line line-accent">Smarter with AI.</span>
      </h1>

      <p class="hero-lede">
        Notes on software concepts, system design practices, and AI — written from real
        engineering experience, for engineers who want to understand how things work.
      </p>

      <div class="hero-actions">
        <a class="btn btn-primary" href="/concepts">
          Browse concepts
          <ArrowRight size={15} strokeWidth={2} aria-hidden="true" />
        </a>
        <a class="btn btn-outline" href="/system-design">Read a system design</a>
      </div>
    </div>

    <div class="hero-visual">
      <HeroVisual />
    </div>
  </div>

  <div class="hero-stats">
    <StatGrid stats={figures} />
  </div>
</section>

<style>
  .hero {
    position: relative;
    border-bottom: 1px solid var(--border-subtle);
    padding: clamp(1.25rem, 3vw, 2.5rem) 0 clamp(1.75rem, 4vw, 3rem);
  }

  /* Deliberately off-balance: the copy gets the wide column and the
     schematic sits high and right rather than centred against it. */
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 21rem);
    align-items: start;
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }

  .hero-copy {
    padding-top: clamp(0.5rem, 2vw, 1.75rem);
  }

  h1 {
    margin: 0;
    font-size: var(--text-display);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
  }

  .line {
    display: block;
    color: var(--text-primary);
  }

  /* Only the third line takes the accent colour — a single flat
     tint, which is all the emphasis this needs. */
  .line-accent {
    color: var(--accent-ochre);
  }

  .hero-lede {
    margin: 1.5rem 0 0;
    max-width: 46ch;
    font-size: clamp(0.9375rem, 1.4vw, var(--text-body));
    line-height: var(--leading-body);
    color: var(--text-secondary);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    margin-top: 2rem;
  }

  .hero-stats {
    position: relative;
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  /* Staggered entry: nothing mounts all at once. */
  .line,
  .hero-lede,
  .hero-actions,
  .hero-visual,
  .hero-stats {
    animation: rise var(--dur-slow) var(--ease-out) both;
  }
  .line:nth-child(1) {
    animation-delay: 60ms;
  }
  .line:nth-child(2) {
    animation-delay: 120ms;
  }
  .line:nth-child(3) {
    animation-delay: 180ms;
  }
  .hero-lede {
    animation-delay: 240ms;
  }
  .hero-actions {
    animation-delay: 300ms;
  }
  .hero-visual {
    animation-delay: 200ms;
  }
  .hero-stats {
    animation-delay: 360ms;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 62rem) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      order: -1;
      display: flex;
      justify-content: center;
    }
  }

  @media (max-width: 40rem) {
    .hero-visual {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .line,
    .hero-lede,
    .hero-actions,
    .hero-visual,
    .hero-stats {
      animation: none;
    }
  }
</style>
