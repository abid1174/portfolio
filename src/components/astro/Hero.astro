---
import HeroVisual from './HeroVisual.astro';
import StatGrid from './StatGrid.astro';
import { ArrowRight, Command } from 'lucide-react';
import { site } from '../../data/site';
import type { ContentStats } from '../../lib/content';

interface Props {
  stats: ContentStats;
}

const { stats } = Astro.props;

// Every figure is derived from the content collections — adding an
// article updates the hero with no code change.
const figures = [
  { value: String(stats.concepts), label: 'Concepts', accent: 'var(--accent-emerald)' },
  {
    value: String(stats.systemDesigns),
    label: 'System Designs',
    accent: 'var(--accent-lime)',
  },
  {
    value: String(stats.practices),
    label: 'Engineering Practices',
    accent: 'var(--border-strong)',
  },
  { value: String(stats.ai), label: 'AI Notes', accent: 'var(--accent-teal)' },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="aurora" aria-hidden="true"></div>
  <div class="hero-grid grid-backdrop" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="hero-copy">
      <p class="hero-eyebrow">
        <span class="dot" aria-hidden="true"></span>
        Engineering notes · {site.role}
      </p>

      <h1 id="hero-title">
        <span class="line">Clear concepts.</span>
        <span class="line">Scalable systems.</span>
        <span class="line line-accent">Smarter with AI.</span>
      </h1>

      <p class="hero-lede">
        Notes on software concepts, system design practices, and AI — written from real
        engineering experience, for engineers who want to understand how things work.
      </p>

      <div class="hero-actions">
        <a class="btn btn-primary" href="/concepts">
          Browse concepts
          <ArrowRight size={15} strokeWidth={2} aria-hidden="true" />
        </a>
        <a class="btn btn-outline" href="/system-design">Read a system design</a>
        <p class="hero-hint">
          <span>or press</span>
          <kbd><Command size={10} strokeWidth={2.5} aria-hidden="true" />K</kbd>
          <span>to search</span>
        </p>
      </div>
    </div>

    <div class="hero-visual">
      <HeroVisual />
    </div>
  </div>

  <div class="hero-stats">
    <StatGrid stats={figures} />
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: var(--bg-secondary);
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1.5rem, 4vw, 3rem) clamp(1.5rem, 4vw, 2.5rem);
  }

  /* Mesh of soft green light rather than a flat linear gradient —
     three offset radials that drift slowly against each other. */
  .aurora {
    position: absolute;
    inset: -30% -10%;
    pointer-events: none;
    background:
      radial-gradient(
        32% 40% at 18% 34%,
        color-mix(in oklab, var(--accent-emerald) 30%, transparent),
        transparent 68%
      ),
      radial-gradient(
        28% 34% at 72% 18%,
        color-mix(in oklab, var(--accent-teal) 24%, transparent),
        transparent 70%
      ),
      radial-gradient(
        26% 30% at 52% 74%,
        color-mix(in oklab, var(--accent-lime) 18%, transparent),
        transparent 72%
      );
    filter: blur(64px);
    opacity: 0.9;
    animation: drift 28s var(--ease-out) infinite alternate;
  }

  @keyframes drift {
    from {
      transform: translate3d(-2%, -1%, 0) scale(1);
    }
    to {
      transform: translate3d(3%, 2%, 0) scale(1.08);
    }
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    opacity: 0.4;
    /* Fades out toward the copy so text never fights the grid. */
    mask-image: radial-gradient(80% 60% at 78% 30%, #000 0%, transparent 75%);
    pointer-events: none;
  }

  /* Deliberately off-balance: the copy gets the wide column and the
     schematic sits high and right rather than centred against it. */
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 21rem);
    align-items: start;
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }

  .hero-copy {
    padding-top: clamp(0.5rem, 2vw, 1.75rem);
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--text-secondary);
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-emerald);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent-emerald) 18%, transparent);
    animation: pulse 3.2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent-emerald) 18%, transparent);
    }
    50% {
      box-shadow: 0 0 0 6px color-mix(in oklab, var(--accent-emerald) 6%, transparent);
    }
  }

  h1 {
    margin: 0;
    font-size: var(--text-display);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
  }

  .line {
    display: block;
    color: var(--text-primary);
  }

  /* Only the third line takes the gradient — restraint keeps it
     reading as a publication, not a landing page. */
  .line-accent {
    background: linear-gradient(
      100deg,
      var(--accent-emerald) 0%,
      var(--accent-teal) 48%,
      var(--accent-lime) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-lede {
    margin: 1.5rem 0 0;
    max-width: 46ch;
    font-size: clamp(0.9375rem, 1.4vw, var(--text-body));
    line-height: var(--leading-body);
    color: var(--text-secondary);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    margin-top: 2rem;
  }

  .hero-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  kbd {
    display: inline-flex;
    align-items: center;
    gap: 0.1rem;
    padding: 0.1rem 0.32rem;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    background: var(--surface-inset);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-secondary);
  }

  .hero-stats {
    position: relative;
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  /* Staggered entry: nothing mounts all at once. */
  .hero-eyebrow,
  .line,
  .hero-lede,
  .hero-actions,
  .hero-visual,
  .hero-stats {
    animation: rise var(--dur-slow) var(--ease-out) both;
  }
  .line:nth-child(1) {
    animation-delay: 60ms;
  }
  .line:nth-child(2) {
    animation-delay: 120ms;
  }
  .line:nth-child(3) {
    animation-delay: 180ms;
  }
  .hero-lede {
    animation-delay: 240ms;
  }
  .hero-actions {
    animation-delay: 300ms;
  }
  .hero-visual {
    animation-delay: 200ms;
  }
  .hero-stats {
    animation-delay: 360ms;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 62rem) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      order: -1;
      display: flex;
      justify-content: center;
    }
    .hero-grid {
      mask-image: radial-gradient(90% 40% at 50% 12%, #000 0%, transparent 78%);
    }
  }

  @media (max-width: 40rem) {
    .hero-visual {
      display: none;
    }
    .hero-hint {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aurora,
    .dot {
      animation: none;
    }
    .hero-eyebrow,
    .line,
    .hero-lede,
    .hero-actions,
    .hero-visual,
    .hero-stats {
      animation: none;
    }
  }
</style>
