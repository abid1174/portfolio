---
interface Stat {
  value: string;
  label: string;
  accent?: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<dl class="stats">
  {
    stats.map((stat) => (
      <div class="stat" style={stat.accent ? `--stat-accent:${stat.accent}` : undefined}>
        <dt class="stat-value">{stat.value}</dt>
        <dd class="stat-label">{stat.label}</dd>
      </div>
    ))
  }
</dl>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
  }

  .stat {
    position: relative;
    padding: 0.9rem 1rem 1rem;
    border-right: 1px solid var(--border-subtle);
  }
  .stat:last-child {
    border-right: 0;
  }

  /* Accent hairline along the top edge of each cell. */
  .stat::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--stat-accent, var(--border-strong));
    opacity: 0.7;
  }

  .stat-value {
    font-size: clamp(1.5rem, 3vw, 1.875rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .stat-label {
    margin: 0.3rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    line-height: 1.35;
  }

  @media (max-width: 46rem) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* With two columns the 2nd cell ends its row. */
    .stat:nth-child(2n) {
      border-right: 0;
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--border-subtle);
    }
  }
</style>
