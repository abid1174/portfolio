---
import ArchitectureDiagram from './ArchitectureDiagram.astro';
import DifficultyBadge from './DifficultyBadge.astro';
import ReadingTime from './ReadingTime.astro';
import type { ContentEntry } from '../../lib/content';

interface Props {
  entry: ContentEntry;
  /** `feature` adds the schematic thumbnail; `list` is the dense form. */
  variant?: 'feature' | 'list';
}

const { entry, variant = 'feature' } = Astro.props;
const diagram = (entry.diagram ?? 'mesh') as
  'fanout' | 'keyvalue' | 'realtime' | 'pipeline' | 'storage' | 'mesh';
---

<article
  class:list={['card card-interactive ticked sd-card pillar-system-design', `is-${variant}`]}
>
  {
    variant === 'feature' && (
      <div class="sd-thumb">
        <ArchitectureDiagram variant={diagram} />
      </div>
    )
  }

  <div class="sd-body">
    <p class="label-mono sd-category">{entry.category}</p>
    {entry.scale && <p class="sd-scale">{entry.scale}</p>}

    <h3 class="sd-title">
      <a href={entry.url} class="link-cover">{entry.title}</a>
    </h3>

    <p class="sd-description">{entry.description}</p>

    <footer class="sd-foot">
      <DifficultyBadge difficulty={entry.difficulty} />
      <span class="sd-dot" aria-hidden="true"></span>
      <ReadingTime minutes={entry.readingTime} />
    </footer>
  </div>
</article>

<style>
  .sd-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .sd-thumb {
    position: relative;
    padding: 0.75rem 0.75rem 0;
    background: linear-gradient(to bottom, var(--pillar-wash), transparent 85%);
    border-bottom: 1px solid var(--border-subtle);
  }

  .sd-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.95rem 1.05rem 1rem;
    flex: 1;
  }

  .sd-category {
    margin: 0;
    color: var(--pillar);
  }

  .sd-scale {
    margin: -0.25rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
    /* One line only: these strings vary wildly in length. */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sd-title {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text-primary);
    text-wrap: balance;
  }
  .sd-title a {
    color: inherit;
    text-decoration: none;
  }

  .sd-description {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .sd-foot {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
  }

  .sd-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .is-list .sd-body {
    padding: 0.9rem 1rem;
  }
</style>
