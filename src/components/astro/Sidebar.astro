---
import BrandIcon from './BrandIcon.astro';
import ThemeSwitcher from '../react/ThemeSwitcher';
import { isActiveRoute, navigation } from '../../data/navigation';
import { site } from '../../data/site';

const pathname = Astro.url.pathname;
---

<aside class="sidebar" id="site-sidebar">
  <div class="sidebar-scroll">
    <!-- Profile -->
    <div class="profile">
      <a class="profile-id" href="/">
        <span class="avatar" aria-hidden="true">{site.avatarInitials}</span>
        <span class="profile-text">
          <span class="profile-name">{site.name}</span>
          <span class="profile-role">{site.role}</span>
        </span>
      </a>

      <p class="profile-bio">{site.intro}</p>

      <ul class="profile-social">
        {
          site.social.map((link) => (
            <li>
              <a
                href={link.href}
                rel="me noopener noreferrer"
                target="_blank"
                title={link.label}
              >
                <BrandIcon name={link.label as 'GitHub' | 'LinkedIn'} size={13} />
                <span>{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Primary navigation -->
    <nav class="nav" aria-label="Primary">
      <ul>
        {
          navigation.map((item) => {
            const Icon = item.icon;
            const active = !item.action && isActiveRoute(item.href, pathname);
            return (
              <li class={item.pillar ? `pillar-${item.pillar}` : undefined}>
                {item.action === 'search' ? (
                  <button type="button" class="nav-link is-action" data-open-search>
                    <Icon size={15} strokeWidth={1.9} aria-hidden="true" />
                    <span class="nav-label">{item.label}</span>
                    <kbd class="nav-kbd" aria-hidden="true">
                      ⌘K
                    </kbd>
                  </button>
                ) : (
                  <a
                    class="nav-link"
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                  >
                    <Icon size={15} strokeWidth={1.9} aria-hidden="true" />
                    <span class="nav-label">{item.label}</span>
                  </a>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!-- Personal statement -->
    <div class="sidebar-foot">
      <p class="statement">{site.learningStatement}</p>
      <div class="sidebar-theme">
        <ThemeSwitcher client:idle />
      </div>
    </div>
  </div>
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    width: var(--sidebar-width);
    height: 100dvh;
    position: sticky;
    top: 0;
    flex-shrink: 0;
    border-right: 1px solid var(--border-subtle);
    background: var(--bg-secondary);
  }

  .sidebar-scroll {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* --- Profile --- */

  .profile {
    padding: 1.15rem 1rem 1.1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .profile-id {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    border-radius: var(--radius-md);
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-default);
    background: linear-gradient(140deg, var(--wash-blue), var(--wash-purple)), var(--surface);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text-primary);
  }

  .profile-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .profile-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .profile-role {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .profile-bio {
    margin: 0.85rem 0 0;
    font-size: 0.75rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .profile-social {
    display: flex;
    gap: 0.35rem;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
  }

  .profile-social a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.22rem 0.5rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    font-size: 0.6875rem;
    color: var(--text-muted);
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .profile-social a:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
  }

  /* --- Navigation --- */

  .nav {
    padding: 0.75rem 0.6rem;
    flex: 1;
  }

  .nav ul {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    padding: 0.5rem 0.6rem;
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--text-secondary);
    font-family: inherit;
    font-size: 0.875rem;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .nav-link :global(svg) {
    flex-shrink: 0;
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .nav-link:hover {
    background: var(--surface-hover);
    color: var(--text-primary);
  }
  .nav-link:hover :global(svg) {
    color: var(--pillar);
  }

  .nav-link[aria-current='page'] {
    background: var(--pillar-wash);
    color: var(--text-primary);
    font-weight: 500;
  }
  .nav-link[aria-current='page'] :global(svg) {
    color: var(--pillar);
  }

  /* Active rail on the left edge of the item. */
  .nav-link[aria-current='page']::before {
    content: '';
    position: absolute;
    left: -0.6rem;
    top: 50%;
    transform: translateY(-50%);
    width: 2px;
    height: 1.15rem;
    border-radius: 0 2px 2px 0;
    background: var(--pillar);
  }

  .nav-label {
    flex: 1;
    min-width: 0;
  }

  .nav-kbd {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    padding: 0.05rem 0.25rem;
  }

  /* --- Foot --- */

  .sidebar-foot {
    padding: 0.9rem 1rem 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .statement {
    margin: 0 0 0.85rem;
    font-size: 0.6875rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (max-width: 64rem) {
    .sidebar {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 60;
      width: min(19rem, 84vw);
      transform: translateX(-100%);
      transition: transform var(--dur-base) var(--ease-out);
      box-shadow: var(--shadow-lg);
    }

    :global(body[data-drawer='open']) .sidebar {
      transform: none;
    }
  }
</style>
