---
import { ArrowRight } from 'lucide-react';

interface Props {
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
  /** `page` is the larger variant used at the top of listing pages. */
  level?: 'section' | 'page';
  class?: string;
}

const {
  title,
  description,
  href,
  linkLabel = 'View all',
  level = 'section',
  class: className = '',
} = Astro.props;

const Heading = level === 'page' ? 'h1' : 'h2';
---

<header class:list={['section-header', `is-${level}`, className]}>
  <div class="section-header-text">
    <Heading class="title">{title}</Heading>
    {description && <p class="description">{description}</p>}
  </div>

  {
    href && (
      <a class="section-link" href={href}>
        <span>{linkLabel}</span>
        <ArrowRight size={14} strokeWidth={2} aria-hidden="true" />
      </a>
    )
  }
</header>

<style>
  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .title {
    margin: 0;
    color: var(--text-primary);
  }

  .is-section .title {
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
  }

  .is-page .title {
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-display);
  }

  .description {
    margin: 0.65rem 0 0;
    max-width: 46ch;
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-body);
  }

  .is-page .description {
    font-size: var(--text-lg);
    max-width: 62ch;
    line-height: var(--leading-body);
  }

  .section-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-bottom: 0.2rem;
    color: var(--text-secondary);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .section-link :global(svg) {
    transition: transform var(--dur-base) var(--ease-out);
  }
  .section-link:hover {
    color: var(--pillar);
  }
  .section-link:hover :global(svg) {
    transform: translateX(3px);
  }
</style>
