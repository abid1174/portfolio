---
import { ArrowRight } from 'lucide-react';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
  /** `page` is the larger variant used at the top of listing pages. */
  level?: 'section' | 'page';
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  href,
  linkLabel = 'View all',
  level = 'section',
  class: className = '',
} = Astro.props;

const Heading = level === 'page' ? 'h1' : 'h2';
---

<header class:list={['section-header', `is-${level}`, className]}>
  <div class="section-header-text">
    {eyebrow && <p class="label-mono eyebrow">{eyebrow}</p>}
    <Heading class="title">{title}</Heading>
    {description && <p class="description">{description}</p>}
  </div>

  {
    href && (
      <a class="section-link" href={href}>
        <span>{linkLabel}</span>
        <ArrowRight size={14} strokeWidth={2} aria-hidden="true" />
      </a>
    )
  }
</header>

<style>
  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 0.6rem;
    color: var(--pillar);
  }
  .eyebrow::before {
    content: '';
    width: 14px;
    height: 1px;
    background: currentColor;
  }

  .title {
    margin: 0;
    color: var(--text-primary);
  }

  .is-section .title {
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
  }

  .is-page .title {
    font-size: clamp(2.125rem, 5vw, 2.875rem);
    letter-spacing: -0.03em;
  }

  .description {
    margin: 0.6rem 0 0;
    max-width: 46ch;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .is-page .description {
    font-size: 1.0625rem;
    max-width: 54ch;
  }

  .section-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-bottom: 0.2rem;
    color: var(--text-secondary);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .section-link :global(svg) {
    transition: transform var(--dur-base) var(--ease-out);
  }
  .section-link:hover {
    color: var(--pillar);
  }
  .section-link:hover :global(svg) {
    transform: translateX(3px);
  }
</style>
