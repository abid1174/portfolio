---
import { navigation } from '../../data/navigation';
import { site } from '../../data/site';

const year = new Date().getFullYear();
const links = navigation.filter((item) => !item.action);
---

<footer class="footer">
  <div class="rule-fade"></div>
  <div class="footer-inner">
    <div class="footer-brand">
      <p class="footer-name">{site.name}</p>
      <p class="footer-tagline">{site.tagline}</p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <ul>
        {
          links.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer-meta">
      <ul class="footer-social">
        {
          site.social.map((link) => (
            <li>
              <a href={link.href} rel="me noopener noreferrer" target="_blank">
                {link.label}
              </a>
            </li>
          ))
        }
        <li><a href={`mailto:${site.email}`}>Email</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
      <p class="footer-copy">© {year} {site.name}. Written, revised, and occasionally wrong.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: 4rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 2rem;
    padding: 2rem 0 2.5rem;
  }

  .footer-name {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .footer-tagline {
    margin: 0.35rem 0 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
    max-width: 26ch;
  }

  .footer-nav ul,
  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-nav ul {
    flex-direction: column;
  }

  .footer-nav a,
  .footer-social a {
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .footer-nav a:hover,
  .footer-social a:hover {
    color: var(--text-primary);
  }

  .footer-meta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .footer-copy {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (max-width: 52rem) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .footer-nav ul {
      flex-direction: row;
    }
  }
</style>
