---
import { ArrowRight } from 'lucide-react';
import { pillarList } from '../../../data/topics';
import type { ContentStats } from '../../../lib/content';

interface Props {
  stats: ContentStats;
}

const { stats } = Astro.props;

const countFor: Record<string, number> = {
  concepts: stats.concepts,
  'system-design': stats.systemDesigns,
  ai: stats.ai,
};
---

<section class="explorer" aria-labelledby="explore-title">
  <h2 class="sr-only" id="explore-title">Explore by topic</h2>

  <ul>
    {
      pillarList.map((pillar) => {
        const Icon = pillar.icon;
        const count = countFor[pillar.id];
        return (
          <li class={pillar.accentClass}>
            <article class="card card-interactive ticked pillar-card">
              <div class="pillar-head">
                <span class="pillar-icon" aria-hidden="true">
                  <Icon size={17} strokeWidth={1.8} />
                </span>
                <span class="pillar-count">
                  {count}
                  <span>entries</span>
                </span>
              </div>

              <h3>
                <a href={pillar.href} class="link-cover">
                  {pillar.label}
                </a>
              </h3>

              <p>{pillar.tagline}</p>

              <span class="pillar-go">
                <span>Explore</span>
                <ArrowRight size={13} strokeWidth={2} aria-hidden="true" />
              </span>
            </article>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pillar-card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    height: 100%;
    padding: 1.1rem 1.15rem 1.15rem;
    background:
      radial-gradient(120% 100% at 100% 0%, var(--pillar-wash), transparent 60%), var(--surface);
  }

  .pillar-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .pillar-icon {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in oklab, var(--pillar) 30%, var(--border-subtle));
    background: var(--pillar-wash);
    color: var(--pillar);
  }

  .pillar-count {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }
  .pillar-count span {
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  h3 {
    margin: 0.15rem 0 0;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }

  p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 30ch;
  }

  .pillar-go {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .pillar-go :global(svg) {
    transition: transform var(--dur-base) var(--ease-out);
  }
  .pillar-card:hover .pillar-go {
    color: var(--pillar);
  }
  .pillar-card:hover .pillar-go :global(svg) {
    transform: translateX(3px);
  }

  @media (max-width: 60rem) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    li:last-child {
      grid-column: span 2;
    }
  }

  @media (max-width: 40rem) {
    ul {
      grid-template-columns: 1fr;
    }
    li:last-child {
      grid-column: auto;
    }
  }
</style>
