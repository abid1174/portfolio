---
import { ArrowRight } from 'lucide-react';
import { pillarList } from '../../../data/topics';
import { ContentRepository, type ContentStats } from '../../../lib/content';

interface Props {
  stats: ContentStats;
}

const { stats } = Astro.props;

const countFor: Record<string, number> = {
  concepts: stats.concepts,
  'system-design': stats.systemDesigns,
  ai: stats.ai,
};

// The lead tile is tall enough to show what is actually inside the
// track, rather than padding the space with air.
const leadCategories = await ContentRepository.categories(pillarList[0].id);
---

<section class="explorer" aria-labelledby="explore-title">
  <h2 class="sr-only" id="explore-title">Explore by topic</h2>

  <ul class="tracks">
    {
      pillarList.map((pillar, index) => {
        const Icon = pillar.icon;
        const count = countFor[pillar.id];
        // The first track carries the section: it gets the tall tile,
        // the longer description and the larger type.
        const lead = index === 0;
        return (
          <li class={pillar.accentClass}>
            <article class:list={['card card-interactive pillar-card', { 'is-lead': lead }]}>
              <div class="pillar-head">
                <span class="pillar-icon" aria-hidden="true">
                  <Icon size={lead ? 20 : 17} strokeWidth={1.7} />
                </span>
                <span class="pillar-count tabular">
                  {count}
                  <span>entries</span>
                </span>
              </div>

              <h3>
                <a href={pillar.href} class="link-cover">
                  {pillar.label}
                </a>
              </h3>

              <p>{lead ? pillar.description : pillar.tagline}</p>

              {lead && (
                <ul class="pillar-topics">
                  {leadCategories.map((category) => (
                    <li>{category}</li>
                  ))}
                </ul>
              )}

              <span class="pillar-go">
                <span>Explore</span>
                <ArrowRight size={13} strokeWidth={2} aria-hidden="true" />
              </span>
            </article>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  /* Asymmetric on purpose — three equal columns would read as a
     stock feature row and flatten the hierarchy between tracks. */
  .tracks {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tracks > li:first-child {
    grid-row: span 2;
  }

  .pillar-card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    height: 100%;
    padding: 1.15rem 1.2rem 1.2rem;
    background:
      radial-gradient(120% 100% at 100% 0%, var(--pillar-wash), transparent 62%), var(--surface);
  }

  /* Softer radius on the large tile, tighter on the small ones. */
  .pillar-card.is-lead {
    border-radius: var(--radius-xl);
    padding: clamp(1.25rem, 2.5vw, 1.9rem);
    gap: 0.7rem;
  }

  .pillar-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .pillar-icon {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    /* Squircle rather than a circle — less generic, and it echoes
       the card corners. */
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in oklab, var(--pillar) 28%, var(--border-subtle));
    background: var(--pillar-wash);
    color: var(--pillar);
    transition:
      background-color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .is-lead .pillar-icon {
    width: 2.6rem;
    height: 2.6rem;
    border-radius: var(--radius-lg);
  }
  .pillar-card:hover .pillar-icon {
    transform: translateY(-2px);
  }

  .pillar-count {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
  }
  .is-lead .pillar-count {
    font-size: 1.5rem;
  }
  .pillar-count span {
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  h3 {
    margin: 0.15rem 0 0;
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
  }
  .is-lead h3 {
    font-size: var(--text-2xl);
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }

  p {
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-body);
    color: var(--text-secondary);
    max-width: 34ch;
  }
  .is-lead p {
    font-size: var(--text-base);
    max-width: 40ch;
  }

  /* What is actually inside the lead track — the tall tile earns
     its height instead of holding empty space. */
  .pillar-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.45rem 0 0;
    padding: 0;
    list-style: none;
  }
  .pillar-topics li {
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: var(--surface-inset);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.03em;
    color: var(--text-muted);
  }

  /* Pinned to the bottom so the three cues line up across the row. */
  .pillar-go {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .pillar-go :global(svg) {
    transition: transform var(--dur-base) var(--ease-out);
  }
  .pillar-card:hover .pillar-go {
    color: var(--pillar);
  }
  .pillar-card:hover .pillar-go :global(svg) {
    transform: translateX(3px);
  }

  @media (max-width: 48rem) {
    .tracks {
      grid-template-columns: 1fr;
    }
    .tracks > li:first-child {
      grid-row: auto;
    }
    .pillar-card.is-lead {
      border-radius: var(--radius-lg);
    }
  }
</style>
