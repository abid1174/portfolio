---
import { ArrowRight, Rss } from 'lucide-react';
import { site } from '../../../data/site';
import type { ContentStats } from '../../../lib/content';

interface Props {
  stats: ContentStats;
}

const { stats } = Astro.props;
---

<section class="cta" aria-labelledby="cta-title">
  <div class="cta-grid grid-backdrop" aria-hidden="true"></div>

  <div class="cta-inner">
    <p class="label-mono cta-eyebrow">Why this exists</p>
    <h2 id="cta-title">{site.manifesto}</h2>

    <p class="cta-body">
      {stats.total} entries so far, across {stats.categories} categories. Nothing here is sponsored,
      generated in bulk, or padded for length — if a page is short, it is because the idea is short.
    </p>

    <div class="cta-actions">
      <a class="cta-btn" href="/about">
        About this site
        <ArrowRight size={14} strokeWidth={2} aria-hidden="true" />
      </a>
      <a class="cta-link" href="/rss.xml">
        <Rss size={13} strokeWidth={2} aria-hidden="true" />
        Follow by RSS
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: linear-gradient(135deg, var(--surface) 0%, var(--bg-secondary) 70%);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .cta-grid {
    position: absolute;
    inset: 0;
    opacity: 0.3;
    mask-image: linear-gradient(to left, #000, transparent 55%);
    pointer-events: none;
  }

  .cta-inner {
    position: relative;
    max-width: 52ch;
  }

  .cta-eyebrow {
    margin: 0 0 0.85rem;
    color: var(--accent-cyan);
  }

  h2 {
    margin: 0;
    font-size: clamp(1.125rem, 2.2vw, 1.5rem);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: -0.015em;
    color: var(--text-primary);
  }

  .cta-body {
    margin: 1rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .cta-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 1.5rem;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text-primary);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .cta-btn:hover {
    border-color: var(--accent-cyan);
  }
  .cta-btn :global(svg) {
    transition: transform var(--dur-base) var(--ease-out);
  }
  .cta-btn:hover :global(svg) {
    transform: translateX(3px);
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-decoration: none;
  }
  .cta-link:hover {
    color: var(--text-primary);
  }
</style>
