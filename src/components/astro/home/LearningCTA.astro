---
import { ArrowRight, Rss } from 'lucide-react';
import { site } from '../../../data/site';
import type { ContentStats } from '../../../lib/content';

interface Props {
  stats: ContentStats;
}

const { stats } = Astro.props;
---

<section class="cta" aria-labelledby="cta-title">
  <div class="cta-grid grid-backdrop" aria-hidden="true"></div>
  <div class="cta-wash" aria-hidden="true"></div>

  <div class="cta-inner">
    <p class="label-mono cta-eyebrow">Why this exists</p>
    <h2 id="cta-title"><span class="quote-mark" aria-hidden="true">“</span>{site.manifesto}</h2>

    <p class="cta-body">
      {stats.total} entries so far, across {stats.categories} categories. Nothing here is sponsored,
      generated in bulk, or padded for length — if a page is short, it is because the idea is short.
    </p>

    <div class="cta-actions">
      <a class="btn btn-outline" href="/about">
        About this site
        <ArrowRight size={14} strokeWidth={2} aria-hidden="true" />
      </a>
      <a class="cta-link" href="/rss.xml">
        <Rss size={13} strokeWidth={2} aria-hidden="true" />
        Follow by RSS
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    background: var(--bg-secondary);
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .cta-grid {
    position: absolute;
    inset: 0;
    opacity: 0.3;
    mask-image: linear-gradient(to left, #000, transparent 55%);
    pointer-events: none;
  }

  /* Ambient light from the right, so the space beside the quote reads
     as deliberate rather than as an empty half. */
  .cta-wash {
    position: absolute;
    inset: -40% -20% -40% 30%;
    background:
      radial-gradient(
        38% 46% at 72% 42%,
        color-mix(in oklab, var(--accent-teal) 22%, transparent),
        transparent 70%
      ),
      radial-gradient(
        30% 40% at 92% 78%,
        color-mix(in oklab, var(--accent-emerald) 18%, transparent),
        transparent 72%
      );
    filter: blur(60px);
    pointer-events: none;
  }

  .cta-inner {
    position: relative;
    max-width: 54ch;
  }

  .cta-eyebrow {
    margin: 0 0 1rem;
    color: var(--accent-teal);
  }

  h2 {
    position: relative;
    margin: 0;
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    text-wrap: pretty;
  }

  /* Hangs into the margin so the first line stays optically flush. */
  .quote-mark {
    position: absolute;
    left: -0.62em;
    top: -0.06em;
    font-size: 1.6em;
    line-height: 1;
    color: color-mix(in oklab, var(--accent-emerald) 45%, transparent);
  }

  .cta-body {
    margin: 1.25rem 0 0;
    font-size: var(--text-base);
    line-height: var(--leading-prose);
    color: var(--text-secondary);
  }

  .cta-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 1.75rem;
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .cta-link:hover {
    color: var(--accent-emerald);
  }

  @media (max-width: 48rem) {
    .quote-mark {
      display: none;
    }
  }
</style>
