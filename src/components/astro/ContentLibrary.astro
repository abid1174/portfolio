---
import AINoteCard from './AINoteCard.astro';
import ConceptCard from './ConceptCard.astro';
import SystemDesignCard from './SystemDesignCard.astro';
import ContentFilter from '../react/ContentFilter';
import { ContentRepository, type ContentEntry } from '../../lib/content';
import { difficulties, pillars, type Pillar } from '../../data/topics';
import { slugify } from '../../lib/utils';

interface Props {
  pillar: Pillar;
  /** `grouped` renders category sections; `grid` renders one flat grid. */
  layout?: 'grouped' | 'grid';
  showDifficulty?: boolean;
  placeholder?: string;
}

const { pillar, layout = 'grouped', showDifficulty = false, placeholder } = Astro.props;

const meta = pillars[pillar];
const [entries, categories] = await Promise.all([
  ContentRepository.byPillar(pillar),
  ContentRepository.categories(pillar),
]);
const groups = layout === 'grouped' ? await ContentRepository.groupedByCategory(pillar) : [];

/**
 * Everything the filter island needs is stamped onto the DOM, so the
 * full library ships as server-rendered HTML and filtering is a
 * matter of toggling `hidden`.
 */
const attrs = (entry: ContentEntry) => ({
  'data-entry': '',
  'data-entry-id': entry.id,
  'data-category': entry.category,
  'data-difficulty': entry.difficulty,
  'data-tags': entry.tags.map(slugify).join('|'),
  'data-haystack': [entry.title, entry.description, entry.category, ...entry.tags]
    .join(' ')
    .toLowerCase(),
});
---

<div class="library">
  <ContentFilter
    client:idle
    categories={categories}
    difficulties={showDifficulty ? [...difficulties] : []}
    placeholder={placeholder ?? `Search ${meta.unit}…`}
    total={entries.length}
    unit={meta.unit}
  />

  {
    layout === 'grouped' ? (
      <div class="groups">
        {groups.map((group) => (
          <section
            class="group"
            data-group
            aria-labelledby={`group-${slugify(group.category)}`}
          >
            <h2 class="group-title" id={`group-${slugify(group.category)}`}>
              <span>{group.category}</span>
              <span class="group-count">{group.entries.length}</span>
            </h2>
            <ul class="grid">
              {group.entries.map((entry) => (
                <li {...attrs(entry)}>
                  {pillar === 'ai' ? (
                    <AINoteCard entry={entry} />
                  ) : pillar === 'system-design' ? (
                    <SystemDesignCard entry={entry} variant="list" />
                  ) : (
                    <ConceptCard entry={entry} />
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    ) : (
      <ul class="is-featured grid">
        {entries.map((entry) => (
          <li {...attrs(entry)}>
            <SystemDesignCard entry={entry} />
          </li>
        ))}
      </ul>
    )
  }

  <p class="empty" data-empty-state hidden>
    Nothing matches those filters yet. Try clearing one, or
    <button type="button" data-open-search class="empty-search">search everything</button>.
  </p>
</div>

<style>
  .library {
    display: grid;
    gap: 1.75rem;
  }

  .groups {
    display: grid;
    gap: 2rem;
  }

  .group-title {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .group-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border-subtle);
  }

  .group-count {
    order: 3;
    color: var(--pillar);
    font-size: 0.6875rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid.is-featured {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .grid > li {
    min-width: 0;
  }

  .empty {
    margin: 0;
    padding: 2.5rem 1rem;
    text-align: center;
    font-size: 0.9375rem;
    color: var(--text-muted);
    border: 1px dashed var(--border-default);
    border-radius: var(--radius-lg);
  }

  .empty-search {
    border: 0;
    background: none;
    padding: 0;
    color: var(--pillar);
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  @media (max-width: 72rem) {
    .grid.is-featured {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 64rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .grid,
    .grid.is-featured {
      grid-template-columns: 1fr;
    }
  }
</style>
